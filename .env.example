# Settings for `pnpm try <duty>`, which runs one duty on your machine against a
# real provider and a real thread. Copy this file to `.env` and fill it in;
# `.env` is git-ignored and this one is not, so nothing private belongs below —
# not a key, and not the endpoint you happen to have access to.
#
# Every key is one `action.yml` input, upper-snake-cased. A key left unset falls
# back to that input's own default, so it is worth writing only to change one.
# An exported shell variable beats this file, which is what makes a one-off
# `DRY_RUN=false pnpm try translate` work without an edit.
#
# One file for every duty, because the settings a duty adds are its own and the
# ones below the first heading are shared by all of them. A duty is only ever
# handed the inputs its own `action.yml` declares, so a key belonging to another
# duty is ignored rather than misread.

# ---------------------------------------------------------------------------
# The thread — every duty
# ---------------------------------------------------------------------------

# Which repository holds it, `owner/name`. This one has no default: on a runner
# it comes from the event, and there is no event here.
GITHUB_REPOSITORY=owner/name

# A token that can read that thread — and write to it, once DRY_RUN is off.
# `gh auth token` prints one. It goes in `.env`, never in this file.
GITHUB_TOKEN=

# The issue or pull request number. Required here for the same reason as the
# repository: a workflow gets it from the event, a laptop has to be told.
NUMBER=1

# ---------------------------------------------------------------------------
# The provider — every duty
# ---------------------------------------------------------------------------
#
# Any OpenAI-compatible chat-completions endpoint, without the trailing
# `/chat/completions`. Leave API_KEY empty for a keyless one — that is a
# supported configuration rather than a degraded one, and it is the setup this
# project was designed around.
BASE_URL=https://api.openai.com/v1
API_KEY=
MODELS=gpt-5-mini

# Extra `alias = url` endpoints beyond BASE_URL, comma or newline separated,
# each with an optional `timeout=<duration>` after the url — for example
# `fast = https://api.example.com/v1 timeout=30s`. A model id then routes to
# one with `model@alias`. Empty here as in `action.yml`, which behaves
# exactly as it always has: one endpoint, no alias grammar in play.
ENDPOINTS=

# One `alias = key` per line for every ENDPOINTS alias that needs one.
# Registered as a secret in full before anything else is even parsed.
API_KEYS=

# How long one request is allowed to run before it counts as a timeout —
# weather, not a failure — as a whole number of seconds or minutes, like
# `120s` or `2m`. Applies to BASE_URL and to every ENDPOINTS line that names
# no `timeout=` of its own.
REQUEST_TIMEOUT=120s

# Sampling temperature, between 0 and 2. Empty is the default and omits the
# field from every request outright, because some providers reject it
# outright rather than accept a default.
TEMPERATURE=

# ---------------------------------------------------------------------------
# Safety — every duty
# ---------------------------------------------------------------------------

# Everything except the write: what would have been published is printed
# instead. Turn it off only when you mean to edit a real thread that real
# people can see.
DRY_RUN=true

# Work the backlog instead of the one thread NUMBER names. Off here as in
# `action.yml` — turning it on locally is how a sweep gets tried against a
# real repository before it goes anywhere near a schedule.
SWEEP=false

# The oldest thread a sweep will consider, by creation date: empty for no
# bound, a calendar date, or a duration like `90d`. Left unset here as in
# `action.yml`, which is no bound at all.
SINCE=

# The most threads one sweep will actually process. The value is repeated
# here, as with the settings above, so a local run can be narrowed to a
# handful while trying a provider — the real default lives in `action.yml`.
LIMIT=50

# ---------------------------------------------------------------------------
# `translate`
# ---------------------------------------------------------------------------
#
# WARRANT is not repeated here — it is `triage`'s own setting below, and
# translate reads the same WARRANT this file already sets.

# What a `translate` run may write is decided by the warrant file's
# `duties:` block alone — there is no `apply` input to override it.
# Double-check the file grants whatever you expect a `translate` run to
# write when you try it locally.

# What to translate into — not a claim about what the thread is written in. A
# bare code is enough; the label and the script are read off the runtime's own
# CLDR data. Spell one out as `code:Label:Script` to name it yourself. The
# script is load-bearing either way: it lets a draft be refused for carrying
# another language's letters, and lets detection skip the model when the
# scripts already separate the candidates.
#
# There is no LANGUAGES key here — the input that once duplicated the warrant
# file is gone. The warrant file's own `languages:` key, once written, is the
# whole answer; with the file silent, the duty's documented default
# (`en, vi, zh`) applies.

# Two drafts per language, from two different models where the list is long
# enough to offer one, and a separate panel picking between them. This is the
# quality lever that exists when a stronger model is not on the menu — set
# DRAFTS=1 and JUDGE_MODELS= to watch what a single unmeasured answer looks
# like.
DRAFTS=2
JUDGE_MODELS=

# Source characters read from the thread, or `none` for no bound at all. A
# longer body has its tail dropped and the published block says so. Worth
# lowering while trying a provider — it is the one setting that decides how
# much a run costs. `0` is refused — write `none` for that meaning instead.
MAX_BODY_CHARS=6000

# How large one chunk of a body can be before it is asked for as its own
# request rather than folded into a larger one. Refused below `500` — see
# `translate/action.yml`.
CHUNK_CHARS=6000

# Also translate the replies, each with its own source language and its own
# fingerprint. Off here as in `action.yml`, and worth knowing what it costs
# before turning it on locally: a thread with forty replies is forty more texts,
# times every language each one is missing.
TRANSLATE_REPLIES=false

# How many of a thread's newest replies one run reads, when TRANSLATE_REPLIES
# is on, or `none` for no bound. The value is repeated here as with the
# settings above — the real default lives in `action.yml`.
MAX_REPLIES=100

# How much of the machinery the published block names: `none` (language only),
# `model` (adds the model that wrote the winning draft), or `detail` (adds the
# score, the draft count and every judge vote). `none` here as in `action.yml`;
# `detail` is what makes a local run worth reading while comparing providers.
SHOW_ATTRIBUTION=none

# How many provider requests — detection, drafting and judging combined — one
# run may spend before it stops asking for more, or `none` for no bound. A
# self-imposed ceiling, distinct from the roster simply running dry: what was
# already drafted and published still stands, and only the language, reply or
# thread not yet started is left for a later run. `none` here as in
# `action.yml`.
MAX_REQUESTS=none

# ---------------------------------------------------------------------------
# `triage`
# ---------------------------------------------------------------------------

# Where the taxonomy and the permissions live. Every label this duty may apply
# is named in that file, in your own words, and every effect is checked against
# the parsed file rather than against what the model claimed it was allowed to
# do. A file that cannot be read fails the run: deleting it is the supported way
# to withdraw what Reeve may do, and a run that read the absence as "no
# restrictions" would make deletion the widest setting available.
WARRANT=.github/reeve.yml

# Which of the warrant's taxonomy this run may propose, or empty for the
# whole thing. For the monorepo case — one area per directory, one shared
# WARRANT — see `triage/action.yml`.
LABELS=

# What a `triage` run may do is decided by the warrant file's `duties:` block
# alone — `triage: [label]` means labouring, `triage: [label, comment, close]`
# adds those. There is no `apply` input; edit the file to change what the duty
# is allowed to do. The labels input above still narrows which labels one run
# may propose.

# How sure the verdict has to be before anything is applied. Under the floor the
# labels are still reported, which is how this gets tuned against real threads.
CONFIDENCE=0.75

# A directory of `.ndjson` files recording labels a maintainer changed after a
# run. The nearest few are shown to the model as decisions this project has
# already made. A directory that is not there is the cold start.
CORRECTIONS_DIR=.reeve/corrections

# A cheaper roster, asked the two questions the expensive one should not be paid
# for: which language the thread is in, and whether it is spam or about
# something else. Empty turns the spam screen off; the free screens still run.
SCREEN_MODELS=

# How much authored text is worth a model, in characters — template scaffolding
# and quoted code are stripped before the count, and evidence beats length. `0`
# turns the rule off.
MIN_BODY_CHARS=40

# What this repository is about, in one sentence and in your own words. Used
# only by the spam screen, to tell a real request about something else from a
# real request about this.
ABOUT=

# Which issues a sweep considers, by tracker state: `open`, `closed`, or
# `all`. A resource filter, not a mode. `open` is the ordinary case; `closed`
# and `all` are for bulk migration — `record` composed with `sweep` — see
# `docs/guides/sweep.md`.
SWEEP_STATE=open

# A branch to write corrections to instead of the default branch. When set,
# correction files are committed to this branch and a draft pull request is
# opened for maintainer review. `record` and `open-pr` must both be granted.
# Empty writes directly to the default branch.
STATE_BRANCH=

# ---------------------------------------------------------------------------
# `harmonise`
# ---------------------------------------------------------------------------
#
# Keeps multilingual documentation files synchronised across locales. The source
# language is named explicitly — committed documentation is a deliberate
# organisational decision, not an incidental preference.
#
# WARRANT, MODELS, DRAFTS, JUDGE_MODELS, MAX_REQUESTS, STATE_BRANCH and
# DRY_RUN are not repeated here — they are `translate`'s and `triage`'s own
# settings above, and harmonise reads the same ones. What it may do comes
# from the warrant file's `duties:` block alone: `edit-file` and `open-pr`
# are granted there or not at all. The target languages likewise come from
# the warrant file's `languages:` key, with this duty's documented default
# (`vi, zh`) when the file is silent — the old `languages` input is gone.

# The locale code of the source language — the language unsuffixed
# documentation files are written in. `en`, `zh-Hans`, or any code matching
# the `languages` grammar. The source language stays an input of its own; it
# is a deliberate organisational decision, not something the warrant file
# decides.
SOURCE_LANGUAGE=en

# Where provenance state lives — per-document sync status and source revision
# tracking. The state file is stored at ${PROVENANCE_DIR}/state.json.
# Delete the state file to force a full re-sync.
PROVENANCE_DIR=.reeve/provenance

# A glossary of project-specific terms that translations must respect.
# Overrides = bug. Missing is not an error — it means there are no
# protected terms.
GLOSSARY_DIR=.reeve/glossary.yml

# Doc paths to scan for locale variants, comma or newline separated.
# Empty scans the whole repository.
PATHS=

# Whether to honour `<!-- reeve:ignore-next-line -->` and
# `<!-- reeve:ignore-start/end -->` markers in target files. When true,
# marked sections are preserved as-is and excluded from translation.
IGNORE=true

# ---------------------------------------------------------------------------
# `duplicate`
# ---------------------------------------------------------------------------
#
# WARRANT, CONFIDENCE, MAX_BODY_CHARS and SHOW_ATTRIBUTION are not repeated
# here — they are `triage`'s and `translate`'s own settings above, and Node
# reads one flat environment either way, so a second value here would silently
# win over theirs and break trying those duties next. `duplicate` may post a
# comment only when the warrant file's `duties:` block grants
# `duplicate: [comment]` — add it there to let one run post.

# How many of the closest-ranked open threads reach the judge — the shortlist
# it is shown and asked to pick from, not a search results page.
CANDIDATES=5

# How many open threads the ranking runs against, newest created first. `none`
# is every open issue; narrow it for a large tracker while trying a provider.
CORPUS_LIMIT=none

# The oldest thread the comparison corpus considers, by creation date. Empty
# for no bound, a calendar date, or a duration like `90d` — a cost control,
# not a correctness setting.
CORPUS_SINCE=

# ---------------------------------------------------------------------------
# `respond`
# ---------------------------------------------------------------------------

# Reuses WARRANT, CONFIDENCE, CORRECTIONS, MODELS, JUDGE_MODELS,
# DRAFTS, MAX_BODY_CHARS, SCREEN_MODELS and ABOUT from the sections above —
# a duty asked to speak needs the same knobs a duty asked to judge does, plus
# one of its own below. The target languages come from the warrant file's
# `languages:` key, with the documented default (`en, vi, zh`) when the file
# is silent. `respond` reads nothing named `translate` or `triage` here; it
# is only handed the inputs its own `action.yml` declares.

# A maintainer-authored file the drafting model is told to follow, the same
# way it is told to follow the system prompt — not thread text, and not
# something a commenter can steer. Missing is the cold start, read the same as
# an empty one: nothing extra to say yet.
GUIDANCE=.github/reeve-guidance.md
