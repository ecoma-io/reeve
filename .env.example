# Settings for `pnpm try <duty>`, which runs one duty on your machine against a
# real provider and a real thread. Copy this file to `.env` and fill it in;
# `.env` is git-ignored and this one is not, so nothing private belongs below —
# not a key, and not the endpoint you happen to have access to.
#
# Every key is one `action.yml` input, upper-snake-cased. A key left unset falls
# back to that input's own default, so it is worth writing only to change one.
# An exported shell variable beats this file, which is what makes a one-off
# `DRY_RUN=false pnpm try translate` work without an edit.
#
# One file for every duty, because the settings a duty adds are its own and the
# ones below the first heading are shared by all of them. A duty is only ever
# handed the inputs its own `action.yml` declares, so a key belonging to another
# duty is ignored rather than misread.

# ---------------------------------------------------------------------------
# The thread — every duty
# ---------------------------------------------------------------------------

# Which repository holds it, `owner/name`. This one has no default: on a runner
# it comes from the event, and there is no event here.
GITHUB_REPOSITORY=owner/name

# A token that can read that thread — and write to it, once DRY_RUN is off.
# `gh auth token` prints one. It goes in `.env`, never in this file.
GITHUB_TOKEN=

# The issue or pull request number. Required here for the same reason as the
# repository: a workflow gets it from the event, a laptop has to be told.
NUMBER=1

# ---------------------------------------------------------------------------
# The provider — every duty
# ---------------------------------------------------------------------------
#
# Any OpenAI-compatible chat-completions endpoint, without the trailing
# `/chat/completions`. Leave API_KEY empty for a keyless one — that is a
# supported configuration rather than a degraded one, and it is the setup this
# project was designed around.
BASE_URL=https://api.openai.com/v1
API_KEY=
MODELS=gpt-5-mini

# ---------------------------------------------------------------------------
# Safety — every duty
# ---------------------------------------------------------------------------

# Everything except the write: what would have been published is printed
# instead. Turn it off only when you mean to edit a real thread that real
# people can see.
DRY_RUN=true

# ---------------------------------------------------------------------------
# `translate`
# ---------------------------------------------------------------------------

# What to translate into — not a claim about what the thread is written in. A
# bare code is enough; the label and the script are read off the runtime's own
# CLDR data. Spell one out as `code:Label:Script` to name it yourself. The
# script is load-bearing either way: it lets a draft be refused for carrying
# another language's letters, and lets detection skip the model when the
# scripts already separate the candidates. The value is repeated here so a
# local run is easy to narrow to one language while trying a provider — the
# real default lives in `action.yml`, and leaving this unset takes it from
# there.
LANGUAGES=en,vi,zh

# Two drafts per language, from two different models where the list is long
# enough to offer one, and a separate panel picking between them. This is the
# quality lever that exists when a stronger model is not on the menu — set
# DRAFTS=1 and JUDGE_MODELS= to watch what a single unmeasured answer looks
# like.
DRAFTS=2
JUDGE_MODELS=

# Source characters read from the thread; the tail is dropped and the published
# block says so. Worth lowering while trying a provider — it is the one setting
# that decides how much a run costs.
MAX_BODY_CHARS=6000

# Also translate the replies, each with its own source language and its own
# fingerprint. Off here as in `action.yml`, and worth knowing what it costs
# before turning it on locally: a thread with forty replies is forty more texts,
# times every language each one is missing.
TRANSLATE_REPLIES=false

# How much of the machinery the published block names: `none` (language only),
# `model` (adds the model that wrote the winning draft), or `detail` (adds the
# score, the draft count and every judge vote). `none` here as in `action.yml`;
# `detail` is what makes a local run worth reading while comparing providers.
SHOW_ATTRIBUTION=none
