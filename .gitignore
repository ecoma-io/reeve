.DS_Store
*.local
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Claude Code local overrides — the shared settings.json IS tracked.
.claude/settings.local.json

# Agent worktrees
.claude/worktrees/
