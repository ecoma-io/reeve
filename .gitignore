node_modules/
coverage/

# NOTE: `dist/` is deliberately NOT ignored. A JavaScript action runs straight
# off the checked-out repository with no install step, so the bundle has to be
# committed — see tools/build.mjs. CI fails when it is stale.

# Local settings for `pnpm try <duty>`, which holds a real token. `.env.example` is the
# tracked half and carries no secret.
.env

